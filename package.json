{
  "name": "turismo-sms-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:reservations": "node --test --test-concurrency=1 tests/reservations-truthful-state.test.mjs",
    "test:consent": "node --test --test-concurrency=1 tests/consent-first.test.mjs",
    "test:hero-deferred": "node --test --test-concurrency=1 tests/hero-video-deferred.test.mjs",
    "test:header-structural": "node --test --test-concurrency=1 tests/header-structural-hardening.test.mjs",
    "test:agrosamas": "node --test --test-concurrency=1 tests/agrosamas-architecture-contract.test.mjs tests/agrosamas-visual-foundation.test.mjs tests/agrosamas-global-integration.test.mjs tests/agrosamas-location-data.test.mjs tests/event-occurrence-adapter.test.mjs tests/home-events-identity-dedup.test.mjs tests/home-events-publication-policy.test.mjs",
    "test:rotas:model": "node --test --test-concurrency=1 tests/rotas-v1.1-model.test.mjs",
    "test:rotas:public": "node --test --test-concurrency=1 tests/public-routes-adapter.test.mjs",
    "canary:rotas:public": "node scripts/rotas-v1.1-public-canary.mjs",
    "test:rotas:dry-run": "node scripts/rotas-v1.1-normalize-dry-run.mjs",
    "test:media-reference-safety": "node --test --test-concurrency=1 tests/media-reference-safety.test.mjs",
    "test:rules:firestore:node": "node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/firestore.rotas.rules.test.mjs tests/firestore.reservations.rules.test.mjs tests/admin-finalization.rules.test.mjs",
    "test:admin-finalization": "node --test --test-concurrency=1 tests/admin-finalization.structure.test.mjs tests/functions.audit.test.cjs tests/public-admin-config.test.mjs",
    "test:admin-public-e2e:node": "node --test --test-concurrency=1 tests/admin-public-e2e.test.mjs",
    "test:admin-public-e2e": "firebase emulators:exec --only firestore,storage --project demo-turismo-sms-admin-finalization \"npm run test:admin-public-e2e:node\"",
    "test:rules:storage:node": "node --test --test-concurrency=1 tests/storage.rules.test.mjs",
    "test:rules:node": "npm run test:rotas:model && npm run test:rotas:dry-run && npm run test:media-reference-safety && npm run test:rules:firestore:node && npm run test:rules:storage:node",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-turismo-sms-rules-test \"npm run test:rules:node\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0"
  }
}
