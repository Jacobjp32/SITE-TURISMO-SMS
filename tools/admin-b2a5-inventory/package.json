  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 admin-b2a5-inventory.test.mjs",
    "test:unit": "node --test --test-concurrency=1 --test-name-pattern=\"^(?!EMULATOR:)\" admin-b2a5-inventory.test.mjs",
