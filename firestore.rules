rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function hasRole(roles) {
      return signedIn() && userDoc().data.role in roles && userDoc().data.ativo == true;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isModerator() {
      return hasRole(['admin', 'moderator']);
    }

    function validUserAuthorizationProfile(data) {
      return data.role in ['admin', 'moderator', 'user'] &&
        data.ativo is bool;
    }

    function galleryFieldsAllowed(data) {
      return data.keys().hasOnly([
        'mediaId', 'url', 'storagePath', 'mediaType', 'category',
        'displayOrder', 'published', 'caption', 'alt', 'createdAt',
        'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'
      ]);
    }

    function validGalleryData(data) {
      return galleryFieldsAllowed(data) &&
        data.url is string && data.url.size() > 0 &&
        data.mediaType == 'image' &&
        data.category is string && data.category.size() > 0 &&
        data.displayOrder is int && data.displayOrder >= 0 &&
        data.published is bool && data.caption is string && data.alt is string &&
        data.createdAt is timestamp && data.createdBy is string &&
        data.updatedAt is timestamp && data.updatedBy is string &&
        data.schemaVersion == 1 &&
        (!data.keys().hasAny(['mediaId']) || data.mediaId is string) &&
        (!data.keys().hasAny(['storagePath']) || data.storagePath is string);
    }

    function validGalleryCreate() {
      return isAdmin() && validGalleryData(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function validGalleryUpdate() {
      return isAdmin() && validGalleryData(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function validSeasonalConfig(data) {
      return data.keys().hasOnly(['enabled', 'mode', 'seasonOverride', 'updatedAt', 'updatedBy', 'schemaVersion']) &&
        data.enabled is bool && data.mode in ['AUTO', 'MANUAL'] &&
        ((data.mode == 'AUTO' && data.seasonOverride == null) ||
          (data.mode == 'MANUAL' && data.seasonOverride in ['summer', 'autumn', 'winter', 'spring'])) &&
        data.updatedAt == request.time && data.updatedBy == request.auth.uid &&
        data.schemaVersion == 1;
    }

    function validMascotConfig(data) {
      return data.keys().hasOnly(['enabled', 'updatedAt', 'updatedBy', 'schemaVersion']) &&
        data.enabled is bool && data.updatedAt == request.time &&
        data.updatedBy == request.auth.uid && data.schemaVersion == 1;
    }

    function owns(resourceData) {
      return signedIn() && resourceData.submittedBy == request.auth.uid;
    }

    function ownsUserId(resourceData) {
      return signedIn() && resourceData.userId == request.auth.uid;
    }

    function ownsOwnerUid(resourceData) {
      return signedIn() && resourceData.ownerUid == request.auth.uid;
    }

    function managerDoc(managerId) {
      return get(/databases/$(database)/documents/establishment_managers/$(managerId));
    }

    function validPendingEventCreateBase(eventId) {
      return signedIn() &&
        request.resource.data.id == eventId &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pendente' &&
        request.resource.data.submittedByEmail == request.auth.token.email &&
        request.resource.data.ownerEmail == request.auth.token.email;
    }

    function validCommonPendingEventCreate(eventId) {
      return validPendingEventCreateBase(eventId) &&
        request.resource.data.source == 'portal_usuario' &&
        request.resource.data.linkedManagerId == null &&
        request.resource.data.linkedEstablishmentId == null &&
        request.resource.data.linkedEstablishmentName == null &&
        request.resource.data.linkedEstablishmentRole == null;
    }

    function validLinkedPendingEventCreate(eventId) {
      return validPendingEventCreateBase(eventId) &&
        request.resource.data.source == 'establishment_manager' &&
        request.resource.data.linkedManagerId is string &&
        request.resource.data.linkedEstablishmentId is string &&
        request.resource.data.linkedEstablishmentName is string &&
        request.resource.data.linkedEstablishmentRole in ['proprietario', 'gerente_responsavel', 'representante_autorizado'] &&
        exists(/databases/$(database)/documents/establishment_managers/$(request.resource.data.linkedManagerId)) &&
        managerDoc(request.resource.data.linkedManagerId).data.userId == request.auth.uid &&
        managerDoc(request.resource.data.linkedManagerId).data.active == true &&
        managerDoc(request.resource.data.linkedManagerId).data.establishmentId == request.resource.data.linkedEstablishmentId &&
        managerDoc(request.resource.data.linkedManagerId).data.establishmentName == request.resource.data.linkedEstablishmentName &&
        managerDoc(request.resource.data.linkedManagerId).data.role == request.resource.data.linkedEstablishmentRole;
    }

    // --- Banners / Pop-ups (Bloco 4B) ---
    // Schema e decisoes em docs/bloco-4b-rules-banners.md.
    // Leitura publica: apenas status == 'published' (janela startAt/endAt
    // filtrada no client). Escrita: somente isAdmin(). Sem delete direto.
    function isBannerType(value) {
      return value in ['banner', 'popup'];
    }

    function isBannerStatus(value) {
      return value in ['draft', 'published', 'archived'];
    }

    function bannerFieldsAllowed(data) {
      return data.keys().hasOnly([
        'id', 'title', 'slug', 'description', 'type', 'status', 'placement',
        'targetPages', 'imageUrl', 'imagePath', 'imageAlt', 'mediaId',
        'imageUpdatedAt', 'imageUpdatedBy',
        'ctaLabel', 'ctaUrl', 'ctaTarget', 'startAt', 'endAt', 'priority',
        'frequency', 'dismissible', 'showDelayMs', 'maxWidth',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
        'publishedAt', 'archivedAt'
      ]);
    }

    function bannerHasImage(data) {
      return (data.imageUrl is string && data.imageUrl.size() > 0) ||
        (data.mediaId is string && data.mediaId.size() > 0);
    }

    function bannerHasPlacement(data) {
      return (data.placement is string && data.placement.size() > 0) ||
        (data.targetPages is list && data.targetPages.size() > 0);
    }

    function isValidBannerBase(data) {
      return data.title is string && data.title.size() > 0 &&
        isBannerType(data.type) &&
        isBannerStatus(data.status) &&
        bannerFieldsAllowed(data);
    }

    // Janela de datas: so valida coerencia quando ambos definidos.
    function bannerDatesOk(data) {
      return !(data.startAt != null && data.endAt != null) ||
        data.endAt > data.startAt;
    }

    // Para publicar exige imagem (url ou mediaId) e destino (placement/targetPages).
    function isValidBannerPublished(data) {
      return data.status != 'published' ||
        (bannerHasImage(data) && bannerHasPlacement(data));
    }

    function isValidBannerCreate(bannerId) {
      return isAdmin() &&
        request.resource.data.id == bannerId &&
        isValidBannerBase(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        bannerDatesOk(request.resource.data) &&
        isValidBannerPublished(request.resource.data);
    }

    function isValidBannerUpdate() {
      return isAdmin() &&
        request.resource.data.id == resource.data.id &&
        isValidBannerBase(request.resource.data) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt is timestamp &&
        bannerDatesOk(request.resource.data) &&
        isValidBannerPublished(request.resource.data);
    }

    // --- CMS-2B: Empreendimentos internos ---
    // CRUD interno do painel admin. Neste bloco NAO ha leitura publica desta
    // collection, mesmo para status "published"; o site publico ainda nao usa
    // Firestore para empreendimentos.
    function isEstablishmentStatus(value) {
      return value in ['draft', 'published', 'archived'];
    }

    function isDeletableEstablishmentStatus(value) {
      return value in ['draft', 'archived'];
    }

    function establishmentFieldsAllowed(data) {
      return data.keys().hasOnly([
        'id', 'slug', 'name', 'categoryId', 'categoryLabel', 'status',
        'content', 'contact', 'location', 'media', 'relationships',
        'display', 'seo', 'publishing', 'review', 'source',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
        'schemaVersion', 'validatedGroups', 'revision', 'editSession'
      ]);
    }

    function establishmentShellFieldsAllowed(data) {
      return data.keys().hasAll([
          'id', 'slug', 'status', 'createdAt', 'createdBy', 'updatedAt',
          'updatedBy', 'schemaVersion', 'validatedGroups', 'revision'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'status', 'createdAt', 'createdBy', 'updatedAt',
          'updatedBy', 'schemaVersion', 'validatedGroups', 'revision'
        ]);
    }

    function establishmentGroupKeys() {
      return [
        'core', 'content', 'contact', 'location', 'media',
        'relationshipsRouteIds', 'relationshipsRelatedPlaceIds',
        'relationshipsRelatedEventIds',
        'display', 'seo', 'review', 'source', 'lifecycle'
      ];
    }

    function validEstablishmentMarkers(data) {
      return data is map && data.keys().hasOnly(establishmentGroupKeys());
    }

    function validEstablishmentEditSession(data) {
      return data is map &&
        data.keys().hasAll(['resumeStatus', 'startedAt', 'startedBy']) &&
        data.keys().hasOnly(['resumeStatus', 'startedAt', 'startedBy']) &&
        data.resumeStatus == 'published' &&
        data.startedAt is timestamp &&
        data.startedBy is string;
    }

    function validNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validStringListBlock0(value, size) {
      return (size <= 0 || value[0] is string) &&
        (size <= 1 || value[1] is string) &&
        (size <= 2 || value[2] is string) &&
        (size <= 3 || value[3] is string) &&
        (size <= 4 || value[4] is string) &&
        (size <= 5 || value[5] is string) &&
        (size <= 6 || value[6] is string) &&
        (size <= 7 || value[7] is string) &&
        (size <= 8 || value[8] is string) &&
        (size <= 9 || value[9] is string);
    }

    function validStringListBlock1(value, size) {
      return (size <= 10 || value[10] is string) &&
        (size <= 11 || value[11] is string) &&
        (size <= 12 || value[12] is string) &&
        (size <= 13 || value[13] is string) &&
        (size <= 14 || value[14] is string) &&
        (size <= 15 || value[15] is string) &&
        (size <= 16 || value[16] is string) &&
        (size <= 17 || value[17] is string) &&
        (size <= 18 || value[18] is string) &&
        (size <= 19 || value[19] is string);
    }

    function validStringListBlock2(value, size) {
      return (size <= 20 || value[20] is string) &&
        (size <= 21 || value[21] is string) &&
        (size <= 22 || value[22] is string) &&
        (size <= 23 || value[23] is string) &&
        (size <= 24 || value[24] is string) &&
        (size <= 25 || value[25] is string) &&
        (size <= 26 || value[26] is string) &&
        (size <= 27 || value[27] is string) &&
        (size <= 28 || value[28] is string) &&
        (size <= 29 || value[29] is string);
    }

    function validStringListBlock3(value, size) {
      return (size <= 30 || value[30] is string) &&
        (size <= 31 || value[31] is string) &&
        (size <= 32 || value[32] is string) &&
        (size <= 33 || value[33] is string) &&
        (size <= 34 || value[34] is string) &&
        (size <= 35 || value[35] is string) &&
        (size <= 36 || value[36] is string) &&
        (size <= 37 || value[37] is string) &&
        (size <= 38 || value[38] is string) &&
        (size <= 39 || value[39] is string);
    }

    function validStringListBlock4(value, size) {
      return (size <= 40 || value[40] is string) &&
        (size <= 41 || value[41] is string) &&
        (size <= 42 || value[42] is string) &&
        (size <= 43 || value[43] is string) &&
        (size <= 44 || value[44] is string) &&
        (size <= 45 || value[45] is string) &&
        (size <= 46 || value[46] is string) &&
        (size <= 47 || value[47] is string) &&
        (size <= 48 || value[48] is string) &&
        (size <= 49 || value[49] is string);
    }

    function validStringListFullBlock0(value) {
      return value[0] is string && value[1] is string &&
        value[2] is string && value[3] is string &&
        value[4] is string && value[5] is string &&
        value[6] is string && value[7] is string &&
        value[8] is string && value[9] is string;
    }

    function validStringListFullBlock1(value) {
      return value[10] is string && value[11] is string &&
        value[12] is string && value[13] is string &&
        value[14] is string && value[15] is string &&
        value[16] is string && value[17] is string &&
        value[18] is string && value[19] is string;
    }

    function validStringListFullBlock2(value) {
      return value[20] is string && value[21] is string &&
        value[22] is string && value[23] is string &&
        value[24] is string && value[25] is string &&
        value[26] is string && value[27] is string &&
        value[28] is string && value[29] is string;
    }

    function validStringListFullBlock3(value) {
      return value[30] is string && value[31] is string &&
        value[32] is string && value[33] is string &&
        value[34] is string && value[35] is string &&
        value[36] is string && value[37] is string &&
        value[38] is string && value[39] is string;
    }

    function validStringListFullBlock4(value) {
      return value[40] is string && value[41] is string &&
        value[42] is string && value[43] is string &&
        value[44] is string && value[45] is string &&
        value[46] is string && value[47] is string &&
        value[48] is string && value[49] is string;
    }

    function validStringList(value) {
      let size = value.size();
      return value is list && size <= 50 &&
        (size <= 10
          ? validStringListBlock0(value, size)
          : validStringListFullBlock0(value) && (size <= 20
            ? validStringListBlock1(value, size)
            : validStringListFullBlock1(value) && (size <= 30
              ? validStringListBlock2(value, size)
              : validStringListFullBlock2(value) && (size <= 40
                ? validStringListBlock3(value, size)
                : validStringListFullBlock3(value) && (size < 50
                  ? validStringListBlock4(value, size)
                  : validStringListFullBlock4(value))))));
    }

    function validNullableCoordinate(value, minimum, maximum) {
      return value == null ||
        (value is number && value == value && value >= minimum && value <= maximum);
    }

    function optionalString(data, field) {
      return !(field in data.keys()) || data[field] is string;
    }

    function optionalInt(data, field) {
      return !(field in data.keys()) || data[field] is int;
    }

    function optionalEstablishmentImageStatus(data, field) {
      return !(field in data.keys()) || data[field] in ['active', 'removed'];
    }

    function validEstablishmentImage(data) {
      return data is map &&
        data.keys().hasOnly([
          'url', 'path', 'alt', 'caption', 'credit', 'source',
          'status', 'position',
          'sourceRequestId', 'sourceImagePath', 'uploadedBy', 'uploadedAt',
          'reviewedBy', 'reviewedAt', 'updatedAt', 'updatedBy',
          'removedAt', 'removedBy'
        ]) &&
        data.url is string &&
        data.path is string &&
        data.alt is string &&
        data.caption is string &&
        data.credit is string &&
        data.source is string &&
        optionalEstablishmentImageStatus(data, 'status') &&
        optionalInt(data, 'position') &&
        optionalString(data, 'sourceRequestId') &&
        optionalString(data, 'sourceImagePath') &&
        optionalString(data, 'uploadedBy') &&
        optionalString(data, 'uploadedAt') &&
        optionalString(data, 'reviewedBy') &&
        optionalString(data, 'reviewedAt') &&
        optionalString(data, 'updatedAt') &&
        optionalString(data, 'updatedBy') &&
        optionalString(data, 'removedAt') &&
        optionalString(data, 'removedBy');
    }

    function validEstablishmentContent(data) {
      return data is map &&
        data.keys().hasOnly([
          'summary', 'description', 'longDescription', 'accessibility',
          'openingHours', 'tags', 'notesInternal'
        ]) &&
        data.summary is string &&
        data.description is string &&
        data.longDescription is string &&
        data.accessibility is string &&
        data.openingHours is string &&
        validStringList(data.tags) &&
        data.notesInternal is string;
    }

    function validEstablishmentContact(data) {
      return data is map &&
        data.keys().hasOnly(['phone', 'whatsapp', 'email', 'website', 'instagram', 'facebook']) &&
        data.phone is string &&
        data.whatsapp is string &&
        data.email is string &&
        data.website is string &&
        data.instagram is string &&
        data.facebook is string;
    }

    function validEstablishmentLocation(data) {
      return data is map &&
        data.keys().hasOnly([
          'address', 'neighborhood', 'city', 'state', 'postalCode',
          'coordinates', 'mapsUrl', 'coordStatus', 'coordNote'
        ]) &&
        data.address is string &&
        data.neighborhood is string &&
        data.city is string &&
        data.state is string &&
        data.postalCode is string &&
        data.coordinates is map &&
        data.coordinates.keys().hasOnly(['lat', 'lng']) &&
        validNullableCoordinate(data.coordinates.lat, -90, 90) &&
        validNullableCoordinate(data.coordinates.lng, -180, 180) &&
        data.mapsUrl is string &&
        data.coordStatus is string &&
        data.coordNote is string;
    }

    function validEstablishmentMedia(data) {
      return data is map &&
        data.keys().hasOnly(['mainImage', 'gallery', 'videoUrl', 'sourceCredits']) &&
        validEstablishmentImage(data.mainImage) &&
        data.gallery is list &&
        data.gallery.size() <= 60 &&
        data.videoUrl is string &&
        data.sourceCredits is string;
    }

    function validEstablishmentRelationships(data) {
      return data is map &&
        data.keys().hasAll([
          'routeIds', 'relatedPlaceIds', 'relatedEventIds',
          'legacyRoute', 'legacyRouteName'
        ]) &&
        data.keys().hasOnly([
          'routeIds', 'relatedPlaceIds', 'relatedEventIds',
          'legacyRoute', 'legacyRouteName'
        ]) &&
        validStringList(data.routeIds) &&
        validStringList(data.relatedPlaceIds) &&
        validStringList(data.relatedEventIds) &&
        data.legacyRoute is string &&
        data.legacyRouteName is string;
    }

    function validEstablishmentRelationshipsShape(data) {
      return data is map &&
        data.keys().hasAll([
          'routeIds', 'relatedPlaceIds', 'relatedEventIds',
          'legacyRoute', 'legacyRouteName'
        ]) &&
        data.keys().hasOnly([
          'routeIds', 'relatedPlaceIds', 'relatedEventIds',
          'legacyRoute', 'legacyRouteName'
        ]) &&
        data.legacyRoute is string &&
        data.legacyRouteName is string;
    }

    function validEstablishmentDisplay(data) {
      return data is map &&
        data.keys().hasOnly(['featured', 'priority', 'mapVisible', 'claimable']) &&
        data.featured is bool &&
        data.priority is int &&
        data.mapVisible is bool &&
        data.claimable is bool;
    }

    function validEstablishmentSeo(data) {
      return data is map &&
        data.keys().hasOnly(['title', 'description', 'canonicalPath']) &&
        data.title is string &&
        data.description is string &&
        data.canonicalPath is string;
    }

    function validEstablishmentPublishing(data) {
      return data is map &&
        data.keys().hasOnly([
          'publishedAt', 'publishedBy', 'archivedAt', 'archivedBy', 'archiveReason'
        ]) &&
        validNullableTimestamp(data.publishedAt) &&
        data.publishedBy is string &&
        validNullableTimestamp(data.archivedAt) &&
        data.archivedBy is string &&
        data.archiveReason is string;
    }

    function validEstablishmentReview(data) {
      return data is map &&
        data.keys().hasOnly([
          'lastAppliedRequestId', 'lastAppliedAt', 'lastAppliedBy', 'lastReviewNotes',
          'lastMediaEditedAt', 'lastMediaEditedBy', 'mediaEditReason'
        ]) &&
        data.lastAppliedRequestId is string &&
        validNullableTimestamp(data.lastAppliedAt) &&
        data.lastAppliedBy is string &&
        data.lastReviewNotes is string &&
        validNullableTimestamp(data.lastMediaEditedAt) &&
        data.lastMediaEditedBy is string &&
        data.mediaEditReason is string;
    }

    function validEstablishmentSource(data) {
      return data is map &&
        data.keys().hasOnly([
          'origin', 'sourceFile', 'originalId', 'originalCategory',
          'legacyIds', 'seededAt', 'sourceUpdatedAt'
        ]) &&
        data.origin is string &&
        data.sourceFile is string &&
        data.originalId is string &&
        data.originalCategory is string &&
        validStringList(data.legacyIds) &&
        validNullableTimestamp(data.seededAt) &&
        validNullableTimestamp(data.sourceUpdatedAt);
    }

    function hasEstablishmentIdentity(data) {
      return data is map &&
        data.keys().hasAll(['id', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']);
    }

    function validEstablishmentCore(data) {
      return data.keys().hasAll(['slug', 'name', 'categoryId', 'categoryLabel']) &&
        data.slug is string && data.slug.size() > 0 &&
        data.name is string && data.name.size() > 0 &&
        data.categoryId is string && data.categoryId.size() > 0 &&
        data.categoryLabel is string && data.categoryLabel.size() > 0;
    }

    function validEstablishmentLifecycle(data) {
      return data.keys().hasAll(['status', 'publishing']) &&
        isEstablishmentStatus(data.status) &&
        validEstablishmentPublishing(data.publishing);
    }

    function isValidEstablishmentShellCreate(establishmentId) {
      return isAdmin() &&
        establishmentShellFieldsAllowed(request.resource.data) &&
        request.resource.data.id == establishmentId &&
        request.resource.data.slug == establishmentId &&
        request.resource.data.status == 'draft' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.validatedGroups == {} &&
        request.resource.data.revision == 0;
    }

    function establishmentSourceMetadataValid() {
      return (
          !resource.data.keys().hasAny(['schemaVersion', 'validatedGroups', 'revision'])
        ) || (
          resource.data.keys().hasAll(['schemaVersion', 'validatedGroups', 'revision']) &&
          resource.data.schemaVersion == 2 &&
          resource.data.revision is int && resource.data.revision >= 0 &&
          validEstablishmentMarkers(resource.data.validatedGroups)
        );
    }

    function establishmentEditSessionTransitionValid() {
      return (
          resource.data.keys().hasAny(['editSession']) &&
          !request.resource.data.keys().hasAny(['editSession']) &&
          resource.data.status == 'draft' &&
          request.resource.data.status == 'published' &&
          validEstablishmentEditSession(resource.data.editSession)
        ) || (
          !resource.data.keys().hasAny(['editSession']) &&
          request.resource.data.keys().hasAny(['editSession']) &&
          resource.data.status == 'published' &&
          request.resource.data.status == 'draft' &&
          validEstablishmentEditSession(request.resource.data.editSession) &&
          request.resource.data.editSession.resumeStatus == 'published' &&
          request.resource.data.editSession.startedAt == request.time &&
          request.resource.data.editSession.startedBy == request.auth.uid
        ) || (
          resource.data.keys().hasAny(['editSession']) &&
          request.resource.data.keys().hasAny(['editSession']) &&
          resource.data.status == 'draft' &&
          request.resource.data.status == 'draft' &&
          validEstablishmentEditSession(resource.data.editSession) &&
          request.resource.data.editSession == resource.data.editSession
        ) || (
          !resource.data.keys().hasAny(['editSession']) &&
          !request.resource.data.keys().hasAny(['editSession'])
        );
    }

    function establishmentV2EnvelopeValid() {
      return establishmentFieldsAllowed(request.resource.data) &&
        hasEstablishmentIdentity(resource.data) &&
        hasEstablishmentIdentity(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.revision == resource.data.get('revision', 0) + 1 &&
        validEstablishmentMarkers(request.resource.data.validatedGroups) &&
        establishmentSourceMetadataValid() &&
        (!resource.data.keys().hasAny(['schemaVersion']) ||
          request.resource.data.schemaVersion == resource.data.schemaVersion);
    }

    function establishmentMarkerValid(group) {
      return request.resource.data.validatedGroups[group] == 2 &&
        request.resource.data.validatedGroups.diff(
          resource.data.get('validatedGroups', {})
        ).affectedKeys().hasOnly([group]);
    }

    function establishmentGroupWriteKeysValid(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        fields.concat([
          'updatedAt', 'updatedBy', 'schemaVersion', 'validatedGroups', 'revision'
        ])
      );
    }

    function isCoreGroupWrite() {
      return establishmentGroupWriteKeysValid(['slug', 'name', 'categoryId', 'categoryLabel']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['slug', 'name', 'categoryId', 'categoryLabel', 'validatedGroups']) &&
        establishmentMarkerValid('core') &&
        validEstablishmentCore(request.resource.data);
    }

    function isContentGroupWrite() {
      return establishmentGroupWriteKeysValid(['content']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['content', 'validatedGroups']) &&
        establishmentMarkerValid('content') &&
        validEstablishmentContent(request.resource.data.content);
    }

    function isContactGroupWrite() {
      return establishmentGroupWriteKeysValid(['contact']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['contact', 'validatedGroups']) &&
        establishmentMarkerValid('contact') &&
        validEstablishmentContact(request.resource.data.contact);
    }

    function isLocationGroupWrite() {
      return establishmentGroupWriteKeysValid(['location']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['location', 'validatedGroups']) &&
        establishmentMarkerValid('location') &&
        validEstablishmentLocation(request.resource.data.location);
    }

    function isMediaGroupWrite() {
      return establishmentGroupWriteKeysValid(['media']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['media', 'validatedGroups']) &&
        establishmentMarkerValid('media') &&
        validEstablishmentMedia(request.resource.data.media);
    }

    function establishmentRelationshipWriteKeysValid(field) {
      return establishmentGroupWriteKeysValid(['relationships']) && (
        resource.data.keys().hasAny(['relationships'])
          ? request.resource.data.relationships.diff(resource.data.relationships)
              .affectedKeys().hasOnly(field == 'routeIds'
                ? ['routeIds', 'legacyRoute', 'legacyRouteName']
                : [field])
          : request.resource.data.relationships.relatedPlaceIds.size() == 0 &&
            request.resource.data.relationships.relatedEventIds.size() == 0 &&
            field == 'routeIds'
      );
    }

    function isRelationshipsRouteIdsGroupWrite() {
      return establishmentGroupWriteKeysValid(['relationships']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationships', 'validatedGroups']) &&
        establishmentRelationshipWriteKeysValid('routeIds') &&
        establishmentMarkerValid('relationshipsRouteIds') &&
        validEstablishmentRelationshipsShape(request.resource.data.relationships) &&
        validStringList(request.resource.data.relationships.routeIds);
    }

    function isRelationshipsRelatedPlaceIdsGroupWrite() {
      return establishmentGroupWriteKeysValid(['relationships']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationships', 'validatedGroups']) &&
        establishmentRelationshipWriteKeysValid('relatedPlaceIds') &&
        establishmentMarkerValid('relationshipsRelatedPlaceIds') &&
        validEstablishmentRelationshipsShape(request.resource.data.relationships) &&
        validStringList(request.resource.data.relationships.relatedPlaceIds);
    }

    function isRelationshipsRelatedEventIdsGroupWrite() {
      return establishmentGroupWriteKeysValid(['relationships']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationships', 'validatedGroups']) &&
        establishmentRelationshipWriteKeysValid('relatedEventIds') &&
        establishmentMarkerValid('relationshipsRelatedEventIds') &&
        validEstablishmentRelationshipsShape(request.resource.data.relationships) &&
        validStringList(request.resource.data.relationships.relatedEventIds);
    }

    function isDisplayGroupWrite() {
      return establishmentGroupWriteKeysValid(['display']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['display', 'validatedGroups']) &&
        establishmentMarkerValid('display') &&
        validEstablishmentDisplay(request.resource.data.display);
    }

    function isSeoGroupWrite() {
      return establishmentGroupWriteKeysValid(['seo']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['seo', 'validatedGroups']) &&
        establishmentMarkerValid('seo') &&
        validEstablishmentSeo(request.resource.data.seo);
    }

    function isReviewGroupWrite() {
      return establishmentGroupWriteKeysValid(['review']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['review', 'validatedGroups']) &&
        establishmentMarkerValid('review') &&
        validEstablishmentReview(request.resource.data.review);
    }

    function isSourceGroupWrite() {
      return establishmentGroupWriteKeysValid(['source']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['source', 'validatedGroups']) &&
        establishmentMarkerValid('source') &&
        validEstablishmentSource(request.resource.data.source);
    }

    function establishmentPublishMarkersReady(data) {
      return data.validatedGroups.keys().hasAll(establishmentGroupKeys()) &&
        data.validatedGroups.keys().hasOnly(establishmentGroupKeys()) &&
        data.validatedGroups.core == data.schemaVersion &&
        data.validatedGroups.content == data.schemaVersion &&
        data.validatedGroups.contact == data.schemaVersion &&
        data.validatedGroups.location == data.schemaVersion &&
        data.validatedGroups.media == data.schemaVersion &&
        data.validatedGroups.relationshipsRouteIds == data.schemaVersion &&
        data.validatedGroups.relationshipsRelatedPlaceIds == data.schemaVersion &&
        data.validatedGroups.relationshipsRelatedEventIds == data.schemaVersion &&
        data.validatedGroups.display == data.schemaVersion &&
        data.validatedGroups.seo == data.schemaVersion &&
        data.validatedGroups.review == data.schemaVersion &&
        data.validatedGroups.source == data.schemaVersion &&
        data.validatedGroups.lifecycle == data.schemaVersion;
    }

    function establishmentPublishContentReady(data) {
      return data.keys().hasAll(['name', 'slug', 'categoryId', 'categoryLabel', 'content', 'location']) &&
        data.name is string && data.name.size() > 0 &&
        data.slug is string && data.slug.size() > 0 &&
        data.categoryId is string && data.categoryId.size() > 0 &&
        data.categoryLabel is string && data.categoryLabel.size() > 0 &&
        ((data.content.summary is string && data.content.summary.size() > 0) ||
          (data.content.description is string && data.content.description.size() > 0)) &&
        ((data.location.address is string && data.location.address.size() > 0) ||
          (data.location.coordinates.lat is number &&
            data.location.coordinates.lat >= -90 && data.location.coordinates.lat <= 90 &&
            data.location.coordinates.lng is number &&
            data.location.coordinates.lng >= -180 && data.location.coordinates.lng <= 180));
    }

    function establishmentLifecycleTransitionValid() {
      return (resource.data.status == 'draft' && request.resource.data.status in ['draft', 'published', 'archived']) ||
        (resource.data.status == 'published' && request.resource.data.status in ['draft', 'archived']) ||
        (resource.data.status == 'archived' && request.resource.data.status == 'draft');
    }

    function establishmentLifecycleAuditValid() {
      return (request.resource.data.status == 'published'
          ? request.resource.data.publishing.publishedAt == request.time &&
            request.resource.data.publishing.publishedBy == request.auth.uid &&
            request.resource.data.publishing.archivedAt == null &&
            request.resource.data.publishing.archivedBy == '' &&
            request.resource.data.publishing.archiveReason == '' &&
            establishmentPublishMarkersReady(request.resource.data) &&
            establishmentPublishContentReady(request.resource.data)
          : true) &&
        (request.resource.data.status == 'draft' && resource.data.status == 'published'
          ? request.resource.data.publishing.publishedAt == null &&
            request.resource.data.publishing.publishedBy == ''
          : true) &&
        (request.resource.data.status == 'archived'
          ? request.resource.data.publishing.archivedAt == request.time &&
            request.resource.data.publishing.archivedBy == request.auth.uid
          : request.resource.data.publishing.archivedAt == null &&
            request.resource.data.publishing.archivedBy == '' &&
            request.resource.data.publishing.archiveReason == '');
    }

    function isLifecycleGroupWrite() {
      return establishmentGroupWriteKeysValid(['status', 'publishing', 'editSession']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status', 'publishing', 'editSession', 'validatedGroups']) &&
        establishmentMarkerValid('lifecycle') &&
        validEstablishmentLifecycle(request.resource.data) &&
        establishmentLifecycleTransitionValid() &&
        ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editSession']) &&
            !resource.data.keys().hasAny(['editSession'])) ||
          establishmentEditSessionTransitionValid()) &&
        establishmentLifecycleAuditValid();
    }

    function establishmentMutationSelectsOneGroup() {
      let markerKeys = request.resource.data.validatedGroups.diff(
        resource.data.get('validatedGroups', {})
      ).affectedKeys();
      return markerKeys.size() <= 1 &&
        (markerKeys.size() == 1 ||
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'slug', 'name', 'categoryId', 'categoryLabel', 'content', 'contact',
            'location', 'media', 'relationships', 'display', 'seo', 'review',
            'source', 'status', 'publishing'
          ]));
    }

    function selectedDraftGroupWriteValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let markerKeys = request.resource.data.validatedGroups.diff(
        resource.data.get('validatedGroups', {})
      ).affectedKeys();
      return (changedKeys.hasAny(['slug', 'name', 'categoryId', 'categoryLabel']) || markerKeys.hasAny(['core']))
          ? isCoreGroupWrite()
        : (changedKeys.hasAny(['content']) || markerKeys.hasAny(['content']))
          ? isContentGroupWrite()
        : (changedKeys.hasAny(['contact']) || markerKeys.hasAny(['contact']))
          ? isContactGroupWrite()
        : (changedKeys.hasAny(['location']) || markerKeys.hasAny(['location']))
          ? isLocationGroupWrite()
        : (changedKeys.hasAny(['media']) || markerKeys.hasAny(['media']))
          ? isMediaGroupWrite()
        : (markerKeys.hasAny(['relationshipsRouteIds']) ||
            (changedKeys.hasAny(['relationships']) &&
              request.resource.data.relationships.diff(resource.data.relationships)
                .affectedKeys().hasAny(['routeIds'])))
          ? isRelationshipsRouteIdsGroupWrite()
        : (markerKeys.hasAny(['relationshipsRelatedPlaceIds']) ||
            (changedKeys.hasAny(['relationships']) &&
              request.resource.data.relationships.diff(resource.data.relationships)
                .affectedKeys().hasAny(['relatedPlaceIds'])))
          ? isRelationshipsRelatedPlaceIdsGroupWrite()
        : (markerKeys.hasAny(['relationshipsRelatedEventIds']) ||
            (changedKeys.hasAny(['relationships']) &&
              request.resource.data.relationships.diff(resource.data.relationships)
                .affectedKeys().hasAny(['relatedEventIds'])))
          ? isRelationshipsRelatedEventIdsGroupWrite()
        : (changedKeys.hasAny(['display']) || markerKeys.hasAny(['display']))
          ? isDisplayGroupWrite()
        : (changedKeys.hasAny(['seo']) || markerKeys.hasAny(['seo']))
          ? isSeoGroupWrite()
        : (changedKeys.hasAny(['review']) || markerKeys.hasAny(['review']))
          ? isReviewGroupWrite()
        : (changedKeys.hasAny(['source']) || markerKeys.hasAny(['source']))
          ? isSourceGroupWrite()
        : false;
    }

    function isEstablishmentAtomicRelationshipUpdate() {
      return request.resource.data.keys().hasAll(['validatedGroups']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'relationships', 'updatedAt', 'updatedBy', 'schemaVersion',
          'validatedGroups', 'revision'
        ]) &&
        request.resource.data.validatedGroups.diff(
          resource.data.get('validatedGroups', {})
        ).affectedKeys().size() <= 1 &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationships']) ||
          request.resource.data.validatedGroups.diff(
            resource.data.get('validatedGroups', {})
          ).affectedKeys().hasAny([
            'relationshipsRouteIds', 'relationshipsRelatedPlaceIds',
            'relationshipsRelatedEventIds'
          ]));
    }

    function cheapDraftGroupEnvelopeValid() {
      return isAdmin() &&
        hasEstablishmentIdentity(resource.data) &&
        hasEstablishmentIdentity(request.resource.data) &&
        resource.data.status == 'draft' &&
        request.resource.data.status == 'draft' &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.revision == resource.data.get('revision', 0) + 1 &&
        validEstablishmentMarkers(request.resource.data.validatedGroups) &&
        establishmentSourceMetadataShapeValid();
    }

    function establishmentSourceMetadataShapeValid() {
      return !resource.data.keys().hasAny(['schemaVersion', 'validatedGroups', 'revision']) ||
        (resource.data.keys().hasAll(['schemaVersion', 'validatedGroups', 'revision']) &&
          resource.data.schemaVersion == 2 &&
          resource.data.revision is int && resource.data.revision >= 0 &&
          resource.data.validatedGroups is map);
    }

    function selectedAtomicRelationshipWriteValid() {
      let markerKeys = request.resource.data.validatedGroups.diff(
        resource.data.get('validatedGroups', {})
      ).affectedKeys();
      return (markerKeys.hasAny(['relationshipsRouteIds']) ||
            request.resource.data.relationships.diff(resource.data.relationships)
              .affectedKeys().hasAny(['routeIds', 'legacyRoute', 'legacyRouteName']))
          ? isRelationshipsRouteIdsGroupWrite()
        : (markerKeys.hasAny(['relationshipsRelatedPlaceIds']) ||
            request.resource.data.relationships.diff(resource.data.relationships)
              .affectedKeys().hasAny(['relatedPlaceIds']))
          ? isRelationshipsRelatedPlaceIdsGroupWrite()
        : (markerKeys.hasAny(['relationshipsRelatedEventIds']) ||
            request.resource.data.relationships.diff(resource.data.relationships)
              .affectedKeys().hasAny(['relatedEventIds']))
          ? isRelationshipsRelatedEventIdsGroupWrite()
        : false;
    }

    function isValidEstablishmentAtomicRelationshipUpdate() {
      return cheapDraftGroupEnvelopeValid() &&
        selectedAtomicRelationshipWriteValid();
    }

    function isEstablishmentSourceGroupUpdate() {
      return request.resource.data.keys().hasAll(['validatedGroups']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'source', 'updatedAt', 'updatedBy', 'schemaVersion',
          'validatedGroups', 'revision'
        ]) &&
        request.resource.data.validatedGroups.diff(
          resource.data.get('validatedGroups', {})
        ).affectedKeys().hasOnly(['source']) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['source']) ||
          request.resource.data.validatedGroups.diff(
            resource.data.get('validatedGroups', {})
          ).affectedKeys().hasAny(['source']));
    }

    function isValidEstablishmentSourceGroupUpdate() {
      return cheapDraftGroupEnvelopeValid() && isSourceGroupWrite();
    }

    function isEstablishmentContentGroupUpdate() {
      return request.resource.data.keys().hasAll(['validatedGroups']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'updatedAt', 'updatedBy', 'schemaVersion',
          'validatedGroups', 'revision'
        ]) &&
        request.resource.data.validatedGroups.diff(
          resource.data.get('validatedGroups', {})
        ).affectedKeys().hasOnly(['content']) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['content']) ||
          request.resource.data.validatedGroups.diff(
            resource.data.get('validatedGroups', {})
          ).affectedKeys().hasAny(['content']));
    }

    function isValidEstablishmentContentGroupUpdate() {
      return cheapDraftGroupEnvelopeValid() && isContentGroupWrite();
    }

    function isEstablishmentLifecycleGroupUpdate() {
      return request.resource.data.keys().hasAll(['validatedGroups']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'publishing', 'editSession', 'updatedAt', 'updatedBy',
          'schemaVersion', 'validatedGroups', 'revision'
        ]) &&
        request.resource.data.validatedGroups.diff(
          resource.data.get('validatedGroups', {})
        ).affectedKeys().hasOnly(['lifecycle']) &&
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'publishing', 'editSession']) ||
          request.resource.data.validatedGroups.diff(
            resource.data.get('validatedGroups', {})
          ).affectedKeys().hasAny(['lifecycle']));
    }

    function lifecycleGroupEnvelopeValid() {
      return isAdmin() &&
        hasEstablishmentIdentity(resource.data) &&
        hasEstablishmentIdentity(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.revision == resource.data.get('revision', 0) + 1 &&
        validEstablishmentMarkers(request.resource.data.validatedGroups) &&
        establishmentSourceMetadataShapeValid();
    }

    function isValidEstablishmentLifecycleGroupUpdate() {
      return lifecycleGroupEnvelopeValid() && isLifecycleGroupWrite();
    }

    function isValidEstablishmentV2GroupUpdate() {
      return isAdmin() &&
        establishmentV2EnvelopeValid() &&
        establishmentMutationSelectsOneGroup() &&
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'publishing', 'editSession']) ||
          request.resource.data.validatedGroups.diff(
            resource.data.get('validatedGroups', {})
          ).affectedKeys().hasAny(['lifecycle'])
          ? isLifecycleGroupWrite()
          : resource.data.status == 'draft' &&
            request.resource.data.status == 'draft' &&
            selectedDraftGroupWriteValid());
    }
    // Caminho estreito para o batch N:N do modulo Rotas. Evita reavaliar o
    // schema integral legado (que se aproxima do limite de expressoes) quando
    // somente relationships e a auditoria de update mudam.
    function isValidEstablishmentRelationshipUpdate() {
      return isAdmin() &&
        hasEstablishmentIdentity(resource.data) &&
        hasEstablishmentIdentity(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['relationships', 'updatedAt', 'updatedBy']) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.relationships.diff(resource.data.relationships)
          .affectedKeys().hasOnly(['routeIds']) &&
        validEstablishmentRelationshipsShape(request.resource.data.relationships) &&
        validStringList(request.resource.data.relationships.routeIds);
    }

    function isEstablishmentRelationshipOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['relationships', 'updatedAt', 'updatedBy']);
    }

    // --- Rotas V1.1 ---
    // Modelo editorial por documento. Relacoes N:N continuam exclusivamente
    // em cms_establishments.relationships.routeIds[].
    function isRouteStatus(value) {
      return value in ['draft', 'published', 'archived'];
    }

    function routeFieldsAllowed(data) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'category', 'description', 'color', 'icon',
          'status', 'displayOrder', 'cover', 'tags',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'publishedAt', 'publishedBy', 'archivedAt', 'archivedBy'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'name', 'category', 'description', 'color', 'icon',
          'status', 'displayOrder', 'cover', 'tags',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'publishedAt', 'publishedBy', 'archivedAt', 'archivedBy'
        ]);
    }

    function validRouteCover(data) {
      return data is map &&
        data.keys().hasAll(['mediaId', 'url', 'path', 'alt']) &&
        data.keys().hasOnly(['mediaId', 'url', 'path', 'alt']) &&
        data.mediaId is string && data.mediaId.size() <= 200 &&
        data.url is string && data.url.size() <= 2048 &&
        data.path is string && data.path.size() <= 1024 &&
        data.alt is string && data.alt.size() <= 300;
    }

    function validRouteAudit(data) {
      return data.createdAt is timestamp &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128 &&
        validNullableTimestamp(data.publishedAt) &&
        data.publishedBy is string && data.publishedBy.size() <= 128 &&
        validNullableTimestamp(data.archivedAt) &&
        data.archivedBy is string && data.archivedBy.size() <= 128;
    }

    function validRouteLifecycle(data) {
      return ((data.publishedAt == null && data.publishedBy == '') ||
          (data.publishedAt is timestamp && data.publishedBy.size() > 0)) &&
        ((data.archivedAt == null && data.archivedBy == '') ||
          (data.archivedAt is timestamp && data.archivedBy.size() > 0)) &&
        (data.status != 'published' || data.publishedAt is timestamp) &&
        (data.status != 'archived' || data.archivedAt is timestamp) &&
        (data.status == 'archived' || (data.archivedAt == null && data.archivedBy == ''));
    }

    function validRouteBase(data) {
      return routeFieldsAllowed(data) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 80 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 80 &&
        data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 120 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 4000 &&
        data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$') &&
        data.icon is string && data.icon.size() > 0 && data.icon.size() <= 32 &&
        isRouteStatus(data.status) &&
        data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 100000 &&
        validRouteCover(data.cover) &&
        data.tags is list && data.tags.size() <= 30 &&
        validRouteAudit(data) &&
        validRouteLifecycle(data);
    }

    function routePublishedContentComplete(data) {
      return data.status != 'published' ||
        ((data.cover.url.size() > 0 || data.cover.mediaId.size() > 0) &&
          data.cover.alt.size() > 0);
    }

    function validRouteStatusTransition() {
      return (resource.data.status == 'draft' &&
          request.resource.data.status in ['draft', 'published', 'archived']) ||
        (resource.data.status == 'published' &&
          request.resource.data.status in ['published', 'draft', 'archived']) ||
        (resource.data.status == 'archived' &&
          request.resource.data.status == 'archived');
    }

    function validRoutePublicationUpdate() {
      return (resource.data.publishedAt == null &&
          ((request.resource.data.status == 'published' &&
              request.resource.data.publishedAt == request.time &&
              request.resource.data.publishedBy == request.auth.uid) ||
            (request.resource.data.status != 'published' &&
              request.resource.data.publishedAt == null &&
              request.resource.data.publishedBy == ''))) ||
        (resource.data.publishedAt != null &&
          request.resource.data.publishedAt == resource.data.publishedAt &&
          request.resource.data.publishedBy == resource.data.publishedBy);
    }

    function validRouteArchiveUpdate() {
      return (resource.data.archivedAt == null &&
          ((request.resource.data.status == 'archived' &&
              request.resource.data.archivedAt == request.time &&
              request.resource.data.archivedBy == request.auth.uid) ||
            (request.resource.data.status != 'archived' &&
              request.resource.data.archivedAt == null &&
              request.resource.data.archivedBy == ''))) ||
        (resource.data.archivedAt != null &&
          request.resource.data.archivedAt == resource.data.archivedAt &&
          request.resource.data.archivedBy == resource.data.archivedBy);
    }

    function isValidRouteCreate(routeId) {
      return isAdmin() &&
        validRouteBase(request.resource.data) &&
        request.resource.data.id == routeId &&
        request.resource.data.status == 'draft' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.publishedAt == null &&
        request.resource.data.publishedBy == '' &&
        request.resource.data.archivedAt == null &&
        request.resource.data.archivedBy == '' &&
        routePublishedContentComplete(request.resource.data);
    }

    function isValidRouteUpdate(routeId) {
      return isAdmin() &&
        routeFieldsAllowed(resource.data) &&
        validRouteBase(request.resource.data) &&
        request.resource.data.id == routeId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        (resource.data.publishedAt == null || request.resource.data.slug == resource.data.slug) &&
        validRouteStatusTransition() &&
        validRoutePublicationUpdate() &&
        validRouteArchiveUpdate() &&
        routePublishedContentComplete(request.resource.data);
    }

    match /usuarios/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if validUserAuthorizationProfile(request.resource.data) && (
        isAdmin() || (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'user' &&
          request.resource.data.ativo == true
        )
      );
      allow update: if validUserAuthorizationProfile(request.resource.data) && (
        isAdmin() || (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nome', 'telefone', 'tipo', 'organizacao']) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.ativo == resource.data.ativo
        )
      );
      allow delete: if isAdmin();
    }

    match /eventos_pendentes/{eventId} {
      allow read: if isModerator() || owns(resource.data);
      allow create: if validCommonPendingEventCreate(eventId) ||
        validLinkedPendingEventCreate(eventId);
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    match /estabelecimentos_pendentes/{estId} {
      allow read: if isModerator() || owns(resource.data);
      allow create: if signedIn() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'pendente';
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    match /eventos_aprovados/{eventId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /estabelecimentos_aprovados/{estId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /establishment_claims/{claimId} {
      allow read: if isModerator() || ownsUserId(resource.data);
      allow create: if signedIn() &&
        request.resource.data.id == claimId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'portal_usuario' &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.reviewNotes == '' &&
        request.resource.data.rejectionReason == '' &&
        request.resource.data.requestedRole in ['proprietario', 'gerente_responsavel', 'representante_autorizado'] &&
        request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'userEmail',
          'userName',
          'contactPhone',
          'establishmentId',
          'establishmentName',
          'establishmentCategory',
          'establishmentSource',
          'establishmentOriginalId',
          'requestedRole',
          'status',
          'message',
          'createdAt',
          'updatedAt',
          'reviewedAt',
          'reviewedBy',
          'reviewNotes',
          'rejectionReason',
          'source'
        ]);
      allow update, delete: if isModerator();
    }

    match /establishment_managers/{managerId} {
      allow read: if isModerator() || (
        ownsUserId(resource.data) &&
        resource.data.active == true
      );
      allow create, update, delete: if isModerator();
    }

    match /establishment_update_requests/{requestId} {
      allow read: if isModerator() || ownsOwnerUid(resource.data);
      allow create: if signedIn() &&
        request.resource.data.id == requestId &&
        request.resource.data.managerId is string &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'establishment_manager' &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.reviewNotes == '' &&
        request.resource.data.rejectionReason == '' &&
        request.resource.data.changesRequestedNotes == '' &&
        exists(/databases/$(database)/documents/establishment_managers/$(request.resource.data.managerId)) &&
        managerDoc(request.resource.data.managerId).data.userId == request.auth.uid &&
        managerDoc(request.resource.data.managerId).data.active == true &&
        managerDoc(request.resource.data.managerId).data.establishmentId == request.resource.data.establishmentId &&
        managerDoc(request.resource.data.managerId).data.establishmentName == request.resource.data.establishmentName &&
        request.resource.data.currentSnapshot is map &&
        request.resource.data.currentSnapshot.keys().hasOnly([
          'name',
          'category',
          'source',
          'originalId',
          'description',
          'phone',
          'whatsapp',
          'instagram',
          'website',
          'address',
          'openingHours',
          'images',
          'mainImage',
          'imageCount'
        ]) &&
        request.resource.data.requestedChanges is map &&
        request.resource.data.requestedChanges.keys().hasOnly([
          'description',
          'phone',
          'whatsapp',
          'instagram',
          'website',
          'address',
          'openingHours',
          'additionalNotes'
        ]) &&
        (
          request.resource.data.requestedChanges.keys().size() > 0 ||
          request.resource.data.imageCount > 0
        ) &&
        request.resource.data.images is list &&
        request.resource.data.imageCount == request.resource.data.images.size() &&
        request.resource.data.keys().hasOnly([
          'id',
          'managerId',
          'ownerUid',
          'ownerEmail',
          'ownerName',
          'establishmentId',
          'establishmentName',
          'establishmentCategory',
          'establishmentSource',
          'currentSnapshot',
          'requestedChanges',
          'images',
          'mainImage',
          'imageCount',
          'status',
          'source',
          'createdAt',
          'updatedAt',
          'submittedAt',
          'reviewedAt',
          'reviewedBy',
          'reviewNotes',
          'rejectionReason',
          'changesRequestedNotes'
        ]);
      allow update, delete: if isModerator();
    }

    match /cms_establishments/{establishmentId} {
      // CMS-5C: leitura publica minima apenas para documentos publicados.
      // Firestore Rules nao filtram resultados; queries publicas precisam usar
      // where("status", "==", "published").
      allow get: if isAdmin() || resource.data.status == 'published';
      allow list: if isAdmin() || resource.data.status == 'published';
      allow create: if isValidEstablishmentShellCreate(establishmentId);
      allow update: if isEstablishmentRelationshipOnlyUpdate()
        ? isValidEstablishmentRelationshipUpdate()
        : isEstablishmentAtomicRelationshipUpdate()
          ? isValidEstablishmentAtomicRelationshipUpdate()
          : isEstablishmentLifecycleGroupUpdate()
            ? isValidEstablishmentLifecycleGroupUpdate()
            : isEstablishmentSourceGroupUpdate()
              ? isValidEstablishmentSourceGroupUpdate()
              : isEstablishmentContentGroupUpdate()
                ? isValidEstablishmentContentGroupUpdate()
                : isValidEstablishmentV2GroupUpdate();
      allow delete: if isAdmin() &&
        isDeletableEstablishmentStatus(resource.data.status) &&
        !resource.data.keys().hasAny(['editSession']);
    }

    match /rotas/{routeId} {
      // Firestore Rules nao filtram resultados: consultas publicas devem usar
      // where("status", "==", "published").
      allow get: if isAdmin() || resource.data.status == 'published';
      allow list: if isAdmin() || resource.data.status == 'published';
      allow create: if isValidRouteCreate(routeId);
      allow update: if isValidRouteUpdate(routeId);
      allow delete: if false;
    }

    match /noticias/{noticiaId} {
      allow read: if isAdmin() || (resource.data.publicado == true);
      allow write: if isAdmin();
    }

    match /media_library/{mediaId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /reservas/{reservaId} {
      allow create: if request.resource.data.status == 'pendente' &&
        request.resource.data.keys().hasOnly([
          'id',
          'experienciaId',
          'experienciaNome',
          'data',
          'horario',
          'pessoas',
          'nome',
          'email',
          'telefone',
          'observacoes',
          'valorTotal',
          'status',
          'criadaEm',
          'criadoEm',
          'firestoreId'
        ]);
      allow read, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      // Publico le apenas banners publicados; admin le todos.
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create: if isValidBannerCreate(bannerId);
      allow update: if isValidBannerUpdate();
      // Sem delete direto nesta fase: usar status 'archived'.
      // Outras collections usam delete por moderador/admin, mas banners
      // ficam mais seguros sem exclusao definitiva (ver doc 4B).
      allow delete: if false;
    }

    match /gallery_items/{itemId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create: if validGalleryCreate();
      allow update: if validGalleryUpdate();
      allow delete: if false;
    }

    match /site_config/{configId} {
      allow get: if configId in ['seasonal', 'mascot'];
      allow list: if false;
      allow create, update: if isAdmin() && (
        (configId == 'seasonal' && validSeasonalConfig(request.resource.data)) ||
        (configId == 'mascot' && validMascotConfig(request.resource.data))
      );
      allow delete: if false;
    }

    match /audit_logs/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
